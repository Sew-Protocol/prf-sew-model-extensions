;; Sew-owned source candidate. Runtime dependencies use immutable, publicly
;; fetchable Git subdirectory revisions.
{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.protocol-robustness/prf-core
        {:git/url "https://github.com/protocol-robustness/protocol-robustness-framework.git"
         :git/sha "4c4b9ac4b3bbbac3e44a47cb4df7d5197bee7dc3"
         :deps/root "."}}
 :aliases {:sew-pro-rata-economics
           {:extra-deps
            {org.protocol-robustness/prf-sew-pro-rata-economics
             {:git/url "https://github.com/Sew-Protocol/prf-sew-model-extensions.git"
              :git/sha "a931b1878c7187ae3fb1db2919b462cd59927407"
              :deps/root "extensions/sew-pro-rata-economics"}}}
           :test {:extra-paths ["test"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                               org.protocol-robustness/prf-sew-pro-rata-economics
                               {:git/url "https://github.com/Sew-Protocol/prf-sew-model-extensions.git"
                                :git/sha "a931b1878c7187ae3fb1db2919b462cd59927407"
                                :deps/root "extensions/sew-pro-rata-economics"}}}
           :in-tree-test {:extra-paths ["test"
                                        "../../extensions/sew-yield-integration/src"]
                          :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}}}}
