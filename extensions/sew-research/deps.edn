;; Sew-specific adversarial and economic research built on PRF simulation.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.protocol-robustness/prf-core
        {:git/url "https://github.com/protocol-robustness/protocol-robustness-framework.git"
         :git/sha "4c4b9ac4b3bbbac3e44a47cb4df7d5197bee7dc3"
         :deps/root "."}
        org.protocol-robustness/prf-sew-protocol-model
        {:git/url "https://github.com/Sew-Protocol/prf-sew-model-extensions.git"
         :git/sha "620fbc03431fa99f6174a60ca9851579a7d69a18"
         :deps/root "packages/sew-protocol-model"}
        org.protocol-robustness/prf-sew-research-models
        {:git/url "https://github.com/Sew-Protocol/prf-sew-model-extensions.git"
         :git/sha "a931b1878c7187ae3fb1db2919b462cd59927407"
         :deps/root "extensions/sew-research-models"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {org.protocol-robustness/prf-sew-yield-integration
                               {:git/url "https://github.com/Sew-Protocol/prf-sew-model-extensions.git"
                                :git/sha "a931b1878c7187ae3fb1db2919b462cd59927407"
                                :deps/root "extensions/sew-yield-integration"}}
                  :main-opts ["-m" "resolver-sim.research.sew.test-runner"]}}}
