         :git/sha "a931b1878c7187ae3fb1db2919b462cd59927407"
         :deps/root "packages/sew-protocol-model"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {org.protocol-robustness/prf-sew-yield-integration
